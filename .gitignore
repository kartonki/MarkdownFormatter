.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Cache
.cache/
.next/
out/
tmp/
temp/

# Coverage reports
coverage/

# Optional: Ignore compiled JS if you only want to track JSX/TSX source
*.js
!*.config.js   # Keep config files
!*.test.js     # Keep test files

# Optional: Ignore JSX build artifacts (if compiled separately)
*.jsx
!src/**/*.jsx  # Keep source JSX files in src folder
